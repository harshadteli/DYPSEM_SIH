# ==============================================================================
# DYPSEM SIH 2026 — Git Ignore Configuration (.gitignore)
# ==============================================================================

# 1. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# 2. Editor & IDE Settings
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# 3. Node.js & Dependencies
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# 4. Logs & Debugging Output
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# 5. Build, Cache & Temporary Artifacts
# ------------------------------------------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.temp/
tmp/
temp/
scratch/
*.tmp
*.bak
*.swp
*~

# 6. Environment & Secret Configuration
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example

# 7. Testing & Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
